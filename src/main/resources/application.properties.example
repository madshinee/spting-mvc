# ============================================
# Configuration de la base de données MySQL
# ============================================
spring.datasource.url=jdbc:mysql://localhost:3306/db_produits?useSSL=false&serverTimezone=UTC&createDatabaseIfNotExist=true
spring.datasource.username=usrnm
spring.datasource.password=pswd
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ============================================
# Configuration JPA / Hibernate
# ============================================
# IMPORTANT: Avec Flyway, on utilise "validate" pour vérifier que le schéma
# correspond aux entités, sans laisser Hibernate modifier la structure
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect
spring.jpa.properties.hibernate.format_sql=true

# ============================================
# Configuration Flyway (migrations de base de données)
# ============================================
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baseline-on-migrate=true
spring.flyway.validate-on-migrate=true

# ============================================
# Configuration SpringDoc OpenAPI (Swagger)
# ============================================
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.operationsSorter=method
springdoc.swagger-ui.tagsSorter=alpha
springdoc.swagger-ui.tryItOutEnabled=true

# ============================================
# Configuration du serveur
# ============================================
server.port=8080

# ============================================
# Configuration Actuator (monitoring)
# ============================================
management.endpoints.web.exposure.include=health,info,metrics
management.endpoint.health.show-details=always
